# =============================================================================
# puritymap.conf   DeepPurityMap settings — written once at installation
#
#   Copy this file to puritymap.conf and change only the paths.
#   Format: KEY=VALUE  (anything after '#' is a comment)
#   Paths: absolute, or relative to the folder that holds this file.
#          Windows paths (D:\ref\...) can be used as is.
#
#   Check:  python -m puritymap check --conf puritymap.conf --sheet samples.tsv
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────
# Reference FASTA. The same folder must contain .fai and .dict.
# It must be the same reference used to align the BAMs (verified by the check).
REF_FASTA=/path/to/Homo_sapiens_assembly38.fasta

# Folder with the 4 GATK resources (+ .tbi), Broad standard file names
#   dbsnp_146.hg38.vcf.gz
#   Mills_and_1000G_gold_standard.indels.hg38.vcf.gz
#   Homo_sapiens_assembly38.known_indels.vcf.gz
#   1000G_omni2.5.hg38.vcf.gz
GATK_RESOURCE_DIR=/path/to/gatk_bundle

# Results folder. RESULTS_DIR/<sample_id>/ is created for each sample.
RESULTS_DIR=/path/to/purity_results

# ── Optional: BAM folder ──────────────────────────────────────────────────────
# When set, the bam column of the sample sheet may hold just file names (or paths relative to this folder).
# BAM_DIR=/path/to/bams

# ── Required when WES · Panel samples are present ────────────────────────────
# Capture kit BED (hg38). Used for GATK intervals and the PoN regions.
# WGS is fixed to the bundled WGS_snp.1kb.bed, so it is not set here.
# WES_BED=/path/to/capture_kit.bed
# PANEL_BED=/path/to/panel.bed

# ── Only when tumor-only samples are present ─────────────────────────────────
# Folder where prepare-pon stores its output (per-platform normal reference)
# PON_DIR=/path/to/pon

# ── Optional (defaults exist) ────────────────────────────────────────────────
# THREADS=8
# JAVA_MEM=32G

# Tool locations — leave unset when running with Docker (they are set inside the image).
# Only when running directly on a server without Docker: a command name (looked up on PATH) or an executable path
# GATK=/path/to/gatk-4.6.2.0/gatk
# RSCRIPT=/path/to/conda/envs/r/bin/Rscript             # R with PSCBS · aroma.light · vcfR … installed
# PREDICT_PYTHON=/path/to/conda/envs/dinat/bin/python   # Python with torch · natten · transformers installed
# BEDTOOLS=bedtools

# Set individually only if the GATK resource file names differ from the standard
# DBSNP=/path/to/dbsnp.vcf.gz
# MILLS=/path/to/mills.vcf.gz
# KNOWN_INDELS=/path/to/known_indels.vcf.gz
# OMNI=/path/to/omni.vcf.gz
